{
  "name": "offload",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @offload/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @offload/shared build && pnpm -r test",
    "db:migrate": "pnpm --filter @offload/api prisma migrate dev",
    "db:generate": "pnpm --filter @offload/api prisma generate",
    "db:push": "pnpm --filter @offload/api prisma db push"
  },
  "engines": {
    "node": ">=20"
  }
}

# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --filter @offload/api... --frozen-lockfile

FROM dependencies AS builder
ENV DATABASE_URL=postgresql://offload:offload@postgres:5432/offload
COPY tsconfig.base.json ./
COPY apps/api ./apps/api
COPY packages/shared ./packages/shared
RUN pnpm --filter @offload/shared build \
    && pnpm --filter @offload/api build \
    && pnpm --config.inject-workspace-packages=true --filter @offload/api --prod deploy /prod/api \
    && for prisma_target in /prod/api/node_modules/.pnpm/@prisma+client@*/node_modules; do \
         cp -R /app/node_modules/.pnpm/@prisma+client@*/node_modules/.prisma "$prisma_target/"; \
       done

FROM base AS migrator
ENV NODE_ENV=production
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
WORKDIR /app/apps/api
CMD ["./node_modules/.bin/prisma", "migrate", "deploy"]

FROM node:22-alpine AS runner
ENV NODE_ENV=production
ENV START_SERVER=true
ENV PORT=3001
WORKDIR /app
COPY --from=builder --chown=node:node /prod/api ./
USER node
EXPOSE 3001
CMD ["node", "dist/index.js"]

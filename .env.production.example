APP_DOMAIN=offload.example.com

POSTGRES_USER=offload
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=offload
DATABASE_URL=postgresql://offload:replace-with-a-long-random-password@postgres:5432/offload

JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
